{
  "name": "urwa-policy",
  "version": "0.1.0",
  "private": true,
  "description": "Reference implementation of the uRWA Policy Interface: an external compliance policy for ERC-7943 tokens",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "hardhat build",
    "test": "hardhat test",
    "test:isolated": "hardhat test solidity --test-profile isolated",
    "lint:sol": "solhint --max-warnings 0 'contracts/**/*.sol'",
    "fmt": "forge fmt contracts",
    "fmt:check": "forge fmt --check contracts",
    "check:erc": "python3 -I scripts/check-erc.py",
    "erc:assets": "scripts/build-erc-assets.sh"
  },
  "devDependencies": {
    "@openzeppelin/contracts": "5.6.1",
    "forge-std": "github:foundry-rs/forge-std#v1.16.2",
    "hardhat": "3.20.0",
    "solhint-community": "4.0.1"
  }
}
